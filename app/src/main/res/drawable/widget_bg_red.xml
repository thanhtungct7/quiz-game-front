<?xml version="1.0" encoding="utf-8"?>
<!-- After the evening reminder, with the streak about to break. The app's own danger red
     (Rose500/Rose600 in ui/theme/Color.kt), so the home screen and a wrong answer agree on what
     urgent looks like. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="24dp" />
    <gradient
        android:angle="270"
        android:endColor="#C81E1E"
        android:startColor="#FF4B4B"
        android:type="linear" />
</shape>
