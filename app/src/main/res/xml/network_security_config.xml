<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Cleartext HTTP is only permitted for the local dev backend, reached from the Android
         emulator via its host-loopback alias 10.0.2.2, from an adb-reversed physical device
         via localhost, or from a physical device on the same LAN via the host's LAN IP
         (must match API_BASE_URL in app/build.gradle.kts). Everything else still requires HTTPS. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">192.168.1.8</domain>
    </domain-config>
</network-security-config>
