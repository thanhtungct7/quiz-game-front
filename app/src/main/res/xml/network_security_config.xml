<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Cleartext HTTP is only permitted for the local dev backend, reached from the Android
         emulator via its host-loopback alias 10.0.2.2, from an adb-reversed physical device
         via localhost, or from a physical device on the same LAN via the host's LAN IP.

         A LAN address listed here must ALSO be set as API_BASE_URL in app/build.gradle.kts and
         added to ALLOWED_HOSTS in duo-game-back/.env. All three, or the request dies at a
         different layer each time: silently here, at Retrofit's base URL there, and as a 400
         "Invalid host header" at the server. There is no wildcard form for an IP in this file,
         so every address the router hands out has to be spelled out.

         Everything else still requires HTTPS. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">192.168.1.8</domain>
        <domain includeSubdomains="false">192.168.1.11</domain>
    </domain-config>
</network-security-config>
