<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Asked for at runtime on first sign-in: minSdk is 33, where posting needs the grant. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Asked for the first time the learner taps the mic in an AI conversation. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Package visibility: without these the speech engine and the recognition service are
         invisible to the app, and speech looks unavailable on a phone that has both. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:name=".DuoGameApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Quiz_game">

        <!-- How FCM draws a push that arrives while the app is in the background. A push in the
             foreground is drawn by DuoMessagingService instead. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="streak" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Quiz_game">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Password reset links mailed by the backend (PASSWORD_RESET_URL). An app-private
                 scheme rather than an App Link: there is no domain to host assetlinks.json on. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="reset-password"
                    android:scheme="quizgame" />
            </intent-filter>
        </activity>

        <!-- The home-screen streak widget. Hosted by Glance; the provider XML carries the sizes
             and the half-hourly update period. -->
        <receiver
            android:name=".ui.widget.StreakWidgetReceiver"
            android:exported="false"
            android:label="@string/streak_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/streak_widget_info" />
        </receiver>

        <service
            android:name=".data.push.DuoMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>

</manifest>
